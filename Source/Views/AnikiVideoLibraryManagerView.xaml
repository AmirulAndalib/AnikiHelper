<UserControl x:Class="AnikiHelper.AnikiVideoLibraryManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vc="clr-namespace:AnikiHelper.Services.VideoPlayer"
             MinWidth="900" MinHeight="560">
    <UserControl.Resources>
        <!-- Desktop manager controls deliberately use Playnite desktop theme brushes.
             This prevents WPF from falling back to white system controls. -->
        <Style x:Key="LibraryManagerTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource GlyphBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryManagerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryManagerToolbarButton" TargetType="Button" BasedOn="{StaticResource LibraryManagerButton}">
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="LibraryManagerComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NormalBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryManagerComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource LibraryManagerComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                <Grid>
                                    <ContentPresenter Margin="8,0,30,0"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                                    <ToggleButton HorizontalAlignment="Right" Width="28" Focusable="False"
                                                  Background="Transparent" BorderThickness="0"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <TextBlock Text="▼" Foreground="{DynamicResource TextBrush}" FontSize="10"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource PopupBackgroundBrush}"
                                        BorderBrush="{DynamicResource PopupBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryManagerCard" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,0,14,16"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="LibraryManagerTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ClipToBounds" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid ClipToBounds="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- No fixed TabPanel height: the previous 38px host could clip the
                                 34px tabs once margins/theme DPI were applied. -->
                            <Border Grid.Row="0" Padding="0,4,0,10" ClipToBounds="False">
                                <!-- Normal horizontal host avoids TabPanel clipping at some DPI values. -->
                                <StackPanel IsItemsHost="True"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ClipToBounds="False"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryManagerTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NormalBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <!-- The internal 1px margin keeps the selected border away from every
                             possible host clipping boundary. -->
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource GlyphBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" Background="{DynamicResource WindowBackgourndBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource VideoLibraryManager_Title}" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource VideoLibraryManager_Description}" Opacity="0.72" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBlock Grid.Column="1" x:Name="LibraryCountText" VerticalAlignment="Bottom" Opacity="0.72" Margin="18,0,0,2"/>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="LibrarySearchBox"
                     Grid.Column="0"
                     Style="{StaticResource LibraryManagerTextBox}"
                     MinHeight="34"
                     VerticalContentAlignment="Center"
                     TextChanged="LibrarySearchBox_TextChanged"
                     ToolTip="{DynamicResource VideoLibraryManager_SearchHint}"/>
            <ComboBox x:Name="LibraryFilterCombo"
                      Grid.Column="1"
                      Style="{StaticResource LibraryManagerComboBox}"
                      Margin="10,0,0,0"
                      MinHeight="34"
                      SelectionChanged="LibraryFilterCombo_SelectionChanged">
                <ComboBoxItem Tag="all" Content="{DynamicResource VideoLibraryManager_FilterAll}" IsSelected="True"/>
                <ComboBoxItem Tag="movies" Content="{DynamicResource VideoLibraryManager_FilterMovies}"/>
                <ComboBoxItem Tag="series" Content="{DynamicResource VideoLibraryManager_FilterSeries}"/>
                <ComboBoxItem Tag="anime" Content="{DynamicResource VideoLibraryManager_FilterAnime}"/>
                <ComboBoxItem Tag="problems" Content="{DynamicResource VideoLibraryManager_FilterProblems}"/>
                <ComboBoxItem Tag="unwatched" Content="{DynamicResource VideoLibraryManager_FilterUnwatched}"/>
                <ComboBoxItem Tag="missingcover" Content="{DynamicResource VideoLibraryManager_FilterMissingCover}"/>
                <ComboBoxItem Tag="missinglandscape" Content="{DynamicResource VideoLibraryManager_FilterMissingLandscape}"/>
                <ComboBoxItem Tag="missinghero" Content="{DynamicResource VideoLibraryManager_FilterMissingHero}"/>
                <ComboBoxItem Tag="unavailable" Content="{DynamicResource VideoLibraryManager_FilterUnavailable}"/>
            </ComboBox>
            <Button Grid.Column="2"
                    Style="{StaticResource LibraryManagerToolbarButton}"
                    Content="{DynamicResource VideoLibraryManager_Refresh}"
                    Click="RefreshLibrary_Click"/>
            <Button Grid.Column="3"
                    x:Name="ScanArtworkButton"
                    Style="{StaticResource LibraryManagerToolbarButton}"
                    Content="{DynamicResource VideoArtworkScan_Start}"
                    Click="ScanArtwork_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="620"/>
                <ColumnDefinition Width="0.42*" MinWidth="380" MaxWidth="520"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource GridItemBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="6" Padding="12">
                <Grid>
                    <ListBox x:Name="LibraryItemsList"
                             Foreground="{DynamicResource TextBrush}"
                             Background="Transparent"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource LibraryManagerCard}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="LibraryItemsList_SelectionChanged">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vc:AnikiVideoLibraryManagerItem}">
                                <Border Width="160" MinHeight="268" Background="{DynamicResource ButtonBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="5" Padding="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="218"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#19000000" CornerRadius="3" ClipToBounds="True">
                                            <Grid>
                                                <Image Source="{Binding ArtworkPath, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="Fant"/>
                                                <TextBlock Text="{DynamicResource VideoLibraryManager_NoArtwork}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           TextAlignment="Center" TextWrapping="Wrap" Opacity="0.55" Margin="10">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasArtwork}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Border Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" CornerRadius="14" Background="#C0000000">
                                                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsWatched}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                                    <TextBlock Text="✓" Foreground="{DynamicResource GlyphBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="1,7,1,0" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Row="2" Text="{Binding TypeLabel}" FontSize="11" Opacity="0.65" Margin="1,2,1,0"/>
                                        <Grid Grid.Row="3" Margin="1,2,1,0">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" Opacity="0.72" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsProblem}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ProblemText}" FontSize="11" Foreground="#FFE08080" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProblemText}">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsProblem}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="EmptyLibraryText"
                               Text="{DynamicResource VideoLibraryManager_Empty}"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Opacity="0.7" FontSize="16"/>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Background="{DynamicResource GridItemBackgroundBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    CornerRadius="7"
                    Padding="12,12,5,12">
                <ScrollViewer VerticalScrollBarVisibility="Visible"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              Padding="0,0,8,0">
                    <StackPanel>
                        <!-- ARTWORK -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource VideoLibraryManager_ArtworkSection}"
                                               FontSize="17"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SelectedItem.ProblemText}"
                                               Foreground="#FFE08080"
                                               FontSize="11"
                                               Opacity="0.9"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="210"/>
                                </Grid>

                                <TabControl Style="{StaticResource LibraryManagerTabControl}">
                                    <TabItem Header="{DynamicResource VideoLibraryManager_Cover}" Style="{StaticResource LibraryManagerTabItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Width="158" Height="224"
                                                    HorizontalAlignment="Center"
                                                    Background="#19000000"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding SelectedItem.ArtworkPath, IsAsync=True}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                    <TextBlock Text="{DynamicResource VideoLibraryManager_NoArtwork}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.55">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedItem.HasArtwork}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    x:Name="SearchArtworkButton"
                                                    Style="{StaticResource LibraryManagerButton}"
                                                    Content="{DynamicResource VideoLibraryManager_Change}"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="112"
                                                    Margin="0,8,0,0"
                                                    Click="SearchArtwork_Click"/>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="{DynamicResource VideoLibraryManager_Landscape}" Style="{StaticResource LibraryManagerTabItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Height="178"
                                                    Background="#19000000"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding SelectedItem.LandscapePath, IsAsync=True}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                    <TextBlock Text="{DynamicResource VideoLibraryManager_NoArtwork}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.55">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedItem.HasLandscape}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    x:Name="SearchLandscapeButton"
                                                    Style="{StaticResource LibraryManagerButton}"
                                                    Content="{DynamicResource VideoLibraryManager_Change}"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="112"
                                                    Margin="0,8,0,0"
                                                    Click="SearchLandscape_Click"/>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="{DynamicResource VideoLibraryManager_Hero}" Style="{StaticResource LibraryManagerTabItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Height="178"
                                                    Background="#19000000"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding SelectedItem.HeroPath, IsAsync=True}"
                                                           Stretch="UniformToFill"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                    <TextBlock Text="{DynamicResource VideoLibraryManager_NoArtwork}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.55">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedItem.HasHero}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    x:Name="SearchHeroButton"
                                                    Style="{StaticResource LibraryManagerButton}"
                                                    Content="{DynamicResource VideoLibraryManager_Change}"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="112"
                                                    Margin="0,8,0,0"
                                                    Click="SearchHero_Click"/>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="{DynamicResource VideoLibraryManager_Logo}" Style="{StaticResource LibraryManagerTabItem}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Height="150"
                                                    Background="#19000000"
                                                    BorderBrush="{DynamicResource NormalBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="5"
                                                    ClipToBounds="True"
                                                    Padding="14">
                                                <Grid>
                                                    <Image Source="{Binding SelectedItem.LogoPath, IsAsync=True}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="Fant"/>
                                                    <TextBlock Text="{DynamicResource VideoLibraryManager_NoArtwork}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Opacity="0.55">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding SelectedItem.HasLogo}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <Button Grid.Row="1"
                                                    x:Name="SearchLogoButton"
                                                    Style="{StaticResource LibraryManagerButton}"
                                                    Content="{DynamicResource VideoLibraryManager_Change}"
                                                    HorizontalAlignment="Right"
                                                    MinWidth="112"
                                                    Margin="0,8,0,0"
                                                    Click="SearchLogo_Click"/>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <!-- METADATA -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{DynamicResource VideoLibraryManager_MetadataSection}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Grid.Column="1"
                                            x:Name="EditMetadataButton"
                                            Style="{StaticResource LibraryManagerButton}"
                                            Content="{DynamicResource VideoLibraryManager_EditMetadata}"
                                            MinWidth="108"
                                            Padding="10,3"
                                            Margin="10,0,0,0"
                                            Click="EditMetadata_Click"/>
                                </Grid>
                                <TextBlock Text="{Binding SelectedItem.MetadataSummary}"
                                           Opacity="0.78"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.Genres}"
                                           Opacity="0.66"
                                           Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.Overview}"
                                           Opacity="0.82"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           MaxHeight="115"/>
                            </StackPanel>
                        </Border>

                        <!-- ACTIONS -->
                        <Border Background="{DynamicResource ButtonBackgroundBrush}"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ToggleWatchedButton"
                                            Grid.Column="0"
                                            Style="{StaticResource LibraryManagerButton}"
                                            Content="{DynamicResource VideoLibraryManager_MarkWatched}"
                                            Margin="0,0,4,0"
                                            Click="ToggleWatched_Click"/>
                                    <Button x:Name="OpenFolderButton"
                                            Grid.Column="1"
                                            Style="{StaticResource LibraryManagerButton}"
                                            Content="{DynamicResource VideoLibraryManager_OpenFolder}"
                                            Margin="4,0,0,0"
                                            Click="OpenFolder_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- PATH -->
                        <Border Background="#12000000"
                                BorderBrush="{DynamicResource NormalBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource VideoLibraryManager_Path}"
                                           FontWeight="SemiBold"
                                           FontSize="12"
                                           Opacity="0.78"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedItem.FullPath}"
                                           Opacity="0.55"
                                           FontSize="10.5"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" x:Name="ScanProgressPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,8" Background="{DynamicResource GridItemBackgroundBrush}" BorderThickness="1" BorderBrush="{DynamicResource NormalBorderBrush}" CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="ScanStatusText" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="ScanProgressBar" Minimum="0" Maximum="100" Height="6" Margin="0,7,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CancelScanButton" Style="{StaticResource LibraryManagerButton}" Content="{DynamicResource VideoArtworkScan_Cancel}" Margin="12,0,0,0" MinWidth="90" Visibility="Collapsed" Click="CancelScan_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
