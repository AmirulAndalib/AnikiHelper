<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pctrls="clr-namespace:Playnite.FullscreenApp.Controls;assembly=Playnite.FullscreenApp"
             KeyboardNavigation.TabNavigation="Cycle"
             KeyboardNavigation.DirectionalNavigation="Contained">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="CommunityCardBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F0161C28" Offset="0"/>
            <GradientStop Color="#F00B1018" Offset="0.58"/>
            <GradientStop Color="#F0080C13" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CommunityPreviewTitleFadeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0"/>
            <GradientStop Color="#22000000" Offset="0.35"/>
            <GradientStop Color="#B8000000" Offset="0.78"/>
            <GradientStop Color="#E8000000" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="CommunityCardTopGlowBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#24FFFFFF" Offset="0"/>
            <GradientStop Color="#08FFFFFF" Offset="0.18"/>
            <GradientStop Color="#00FFFFFF" Offset="0.6"/>
        </LinearGradientBrush>

        <Style x:Key="CommunityPremiumBadgeStyle" TargetType="Border">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#C0303B4D"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="40,18,40,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <pctrls:ButtonEx Grid.Column="0"
                             Content="{DynamicResource CommunityPack_Back}"
                             Tag="Back"
                             Height="54"
                             MinWidth="180"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="{Binding WindowTitle}"
                           FontFamily="{DynamicResource FontMain}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="30"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding WindowDescription}"
                           FontFamily="{DynamicResource FontMain}"
                           Foreground="{DynamicResource TextBrush}"
                           Opacity="0.72"
                           FontSize="14"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           MaxWidth="920"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <pctrls:ButtonEx Grid.Column="2"
                             Content="{DynamicResource CommunityPack_Refresh}"
                             Tag="Refresh"
                             Height="54"
                             MinWidth="180"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"/>
        </Grid>

        <!-- Status -->
        <Grid Grid.Row="1" Margin="4,0,4,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding StatusText}"
                       FontFamily="{DynamicResource FontMain}"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.75"
                       FontSize="15"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <TextBlock Grid.Column="1"
                       Text="{Binding CountText}"
                       FontFamily="{DynamicResource FontMain}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Margin="24,0,0,0"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- Catalog -->
        <Grid Grid.Row="2">
            <TextBlock Text="{Binding EmptyText}"
                       FontFamily="{DynamicResource FontMain}"
                       Foreground="{DynamicResource TextBrush}"
                       Opacity="0.72"
                       FontSize="22"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ScrollViewer x:Name="CatalogScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          Focusable="False">
                <ItemsControl ItemsSource="{Binding Packs}"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Continue"
                              Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="376"
                                    Margin="0,0,16,20"
                                    Tag="CommunityCard"
                                    Padding="0"
                                    CornerRadius="12"
                                    Background="{StaticResource CommunityCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource MenuBorderBrush}"
                                    BorderThickness="1"
                                    Focusable="False"
                                    SnapsToDevicePixels="True">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="MinHeight" Value="372"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                <Setter Property="MinHeight" Value="250"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Focusable="False">
                                    <Border Margin="1"
                                            CornerRadius="11"
                                            Background="{StaticResource CommunityCardTopGlowBrush}"
                                            Opacity="0.65"
                                            IsHitTestVisible="False"/>

                                    <Grid Margin="10,10,10,12" Focusable="False">
                                        <Grid.RowDefinitions>
                                            <RowDefinition>
                                                <RowDefinition.Style>
                                                    <Style TargetType="RowDefinition">
                                                        <Setter Property="Height" Value="200"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                                <Setter Property="Height" Value="86"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </RowDefinition.Style>
                                            </RowDefinition>
                                            <RowDefinition Height="84"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Premium preview -->
                                        <Grid Grid.Row="0" Focusable="False">
                                            <Border Background="#78000000"
                                                    CornerRadius="9"
                                                    ClipToBounds="True"
                                                    BorderBrush="#25FFFFFF"
                                                    BorderThickness="1"
                                                    SnapsToDevicePixels="True">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Image Source="{Binding PreviewImage}"
                                                           Stretch="UniformToFill"/>

                                                    <Border VerticalAlignment="Stretch"
                                                            HorizontalAlignment="Stretch"
                                                            Background="{StaticResource CommunityPreviewTitleFadeBrush}"/>

                                                    <TextBlock Text="{DynamicResource CommunityPack_NoPreview}"
                                                               FontFamily="{DynamicResource FontMain}"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               Opacity="0.65"
                                                               FontSize="16"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasPreview}" Value="False">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>

                                                    <StackPanel VerticalAlignment="Bottom"
                                                                Margin="16,0,16,14">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontFamily="{DynamicResource FontMain}"
                                                                   Foreground="White"
                                                                   FontSize="23"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="NoWrap"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <Grid Margin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Text="{Binding AuthorDisplay}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       Foreground="White"
                                                                       Opacity="0.82"
                                                                       FontSize="15"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding VersionDisplay}"
                                                                       FontFamily="{DynamicResource FontMain}"
                                                                       Foreground="White"
                                                                       Opacity="0.76"
                                                                       FontSize="14"
                                                                       Margin="12,0,0,0"
                                                                       TextWrapping="NoWrap"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <StackPanel Margin="12,6,100,0"
                                                        VerticalAlignment="Center">
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ShowPreview}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           Foreground="White"
                                                           FontSize="21"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding AuthorDisplay}"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           Opacity="0.75"
                                                           FontSize="14"
                                                           Margin="0,4,0,0"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Border HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Margin="10">
                                                <Border.Style>
                                                    <Style BasedOn="{StaticResource CommunityPremiumBadgeStyle}" TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Background" Value="#CC8A6125"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Featured}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{DynamicResource CommunityPack_Featured}"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <Border HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Margin="10"
                                                    Style="{StaticResource CommunityPremiumBadgeStyle}"
                                                    Background="{Binding StatusBackground}">
                                                <TextBlock Text="{Binding StatusLabel}"
                                                           FontFamily="{DynamicResource FontMain}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>

                                        <!-- Description -->
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding Description}"
                                                   FontFamily="{DynamicResource FontMain}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   Opacity="0.76"
                                                   FontSize="15"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="4,14,4,8"/>

                                        <!-- Actions -->
                                        <StackPanel Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    Margin="0,2,0,0">
                                            <Grid Width="168" Margin="0,0,5,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasInstallOrUpdateAction}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <pctrls:ButtonEx Content="{Binding ActionText}"
                                                                 IsEnabled="{Binding CanAction}"
                                                                 Tag="InstallOrUpdate"
                                                                 Height="52"
                                                                 HorizontalAlignment="Stretch"/>
                                            </Grid>

                                            <Grid Width="168" Margin="5,0,0,0">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <pctrls:ButtonEx Content="{DynamicResource CommunityPack_Uninstall}"
                                                                 IsEnabled="{Binding CanUninstall}"
                                                                 Tag="Uninstall"
                                                                 Height="52"
                                                                 HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
